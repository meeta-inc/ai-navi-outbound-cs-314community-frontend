# Chromatic (시각적 회귀 테스트)
CHROMATIC_PROJECT_TOKEN=your_chromatic_project_token

# Storybook 환경 설정
STORYBOOK_ENVIRONMENT=development

# 기타 환경 변수 (필요한 경우)
REACT_APP_API_BASE_URL=https://api.example.com

VITE_API_BASE_URL=https://coipekj2sl.execute-api.ap-northeast-1.amazonaws.com/dev
VITE_CHAT_API_URL=https://67hnjuna66.execute-api.ap-northeast-1.amazonaws.com/prd-1
VITE_ACCENT_COLOR=green
VITE_SHOW_NAVIGATION_HEADER=true
VITE_SHOW_TIMESTAMP=true
VITE_FAQ_ICONS={"category1":{"type":"component","value":"ImageIcon"},"category2":{"type":"lucide","value":"Users"},"category3":{"type":"lucide","value":"Trophy"},"category4":{"type":"lucide","value":"FileText"},"other":{"type":"lucide","value":"MoreHorizontal"}}
VITE_SHOW_GRADE_SELECTION=true

# FAQ API 설정
VITE_USE_FAQ_API=false
VITE_CONTENT_CONFIG_API_URL=https://content-config-dev.meeta.jp/v1

# AI 음성 상담 설정
VITE_ENABLE_VOICE_CONSULTATION=false

# OpenAI 음성 인식 설정
VITE_USE_OPENAI_SPEECH=false
VITE_OPENAI_API_KEY=sk-proj-xxxxx  # OpenAI API 키 (sk-proj-로 시작)

# 음성 자동 감지 설정
VITE_VOICE_AUTO_SEND=true             # 자동 전송 활성화
VITE_VOICE_SILENCE_DURATION=1500      # 침묵 감지 시간 (ms)
VITE_VOICE_SILENCE_THRESHOLD=30       # 침묵 임계값 (dB)

# TTS (Text-to-Speech) 설정
VITE_TTS_AUTO_PLAY=true              # 자동 재생 활성화
VITE_TTS_VOICE_MODEL=alloy           # 음성 모델 (alloy, echo, fable, onyx, nova, shimmer)
VITE_TTS_SPEED=1.0                   # 재생 속도 (0.25 ~ 4.0)
VITE_TTS_LANGUAGE=ja                 # 기본 언어 (일본어)

# STT (Speech-to-Text) 설정  
VITE_STT_MODEL=whisper-1             # Whisper 모델
VITE_STT_LANGUAGE=ja                 # 인식 언어 (일본어)
VITE_STT_TEMPERATURE=0.2             # 온도 파라미터 (0~1)